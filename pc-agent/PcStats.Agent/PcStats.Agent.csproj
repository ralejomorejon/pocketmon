<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>PcStats.Agent</RootNamespace>
    <AssemblyName>PocketMon</AssemblyName>
    <Product>PocketMon Agent</Product>
    <Version>1.1.0</Version>
    <ApplicationIcon>pocketmon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="System.Management" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PcStats.Agent.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="tools\**" CopyToOutputDirectory="PreserveNewest" LinkBase="tools" />
    <None Include="logos\**" CopyToOutputDirectory="PreserveNewest" LinkBase="logos" />
    <None Include="games.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Phone web app (PWA), served at / by StatsServer. -->
    <None Include="..\..\web\**" Exclude="..\..\web\test\**;..\..\web\README.md" CopyToOutputDirectory="PreserveNewest" LinkBase="wwwroot" />
  </ItemGroup>

</Project>
